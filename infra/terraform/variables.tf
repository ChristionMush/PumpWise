variable "environment" { type = string }     # staging | production
variable "region" { default = "af-south-1" } # Cape Town: closest AWS region to Zimbabwe
variable "backup_region" { default = "eu-west-1" }
variable "domain_name" { type = string }     # e.g. app.example.com
variable "certificate_arn" { type = string } # ACM certificate in var.region for domain_name
variable "alert_email" { type = string }
variable "backend_image" { type = string } # ECR image URI:tag
variable "frontend_image" { type = string }
variable "vpc_cidr" { default = "10.20.0.0/16" }
variable "db_instance_class" { default = "db.t4g.small" }
variable "db_storage_gb" { default = 40 }
variable "db_backup_days" { default = 14 } # 14 staging, 35 production
variable "db_multi_az" { default = false } # true once there are paying tenants
variable "redis_node_type" { default = "cache.t4g.micro" }
variable "web_count" { default = 1 }
variable "web_cpu" { default = 512 }
variable "web_memory" { default = 1024 }
variable "deletion_protection" { default = false }
variable "log_retention_days" { default = 30 }
variable "monthly_budget_usd" { default = "50" } # cost alarm: email at 80% of actual spend and 100% of forecast
