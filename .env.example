# Copy to .env and fill in. NEVER commit .env. In AWS these come from Secrets Manager.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_HOST=db
DB_PORT=5432
DB_NAME=fuelstation
# Runtime role (RLS applies). Used by the running app.
DB_APP_USER=app_user
DB_APP_PASSWORD=change-me-app
# Migration role. Used ONLY by `migrate --database=owner`.
DB_OWNER_USER=app_owner
DB_OWNER_PASSWORD=change-me-owner
# Superuser: used ONLY by `manage.py bootstrap_db` once. Never by the app.
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=change-me-admin

REDIS_URL=redis://redis:6379/0

# --- optional / later ---
FRONTEND_BASE_URL=http://localhost:5173
BILLING_WEBHOOK_SECRET=change-me
MESSAGE_PROVIDER=apps.insights.messaging.ConsoleProvider
# MESSAGE_GATEWAY_URL=https://sms-gateway.example/send
# MESSAGE_GATEWAY_TOKEN=
# AWS_STORAGE_BUCKET_NAME=      # private media bucket (production)
# EXPORT_S3_BUCKET=             # versioned exports bucket (production)
