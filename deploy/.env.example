# Do not edit this file directly. Run ./init-env.sh to create .env with random secrets.
DOMAIN=__DOMAIN__
ENVIRONMENT=test
# Keep search engines away from test and demo servers. Use "all" in real production.
ROBOTS_TAG=noindex, nofollow

# Match these to the app (settings module, WSGI path and Celery app name are in docker-compose.yml).
DJANGO_SETTINGS_MODULE=config.settings
SECRET_KEY=__SECRET__
ALLOWED_HOSTS=__DOMAIN__,localhost,web
CSRF_TRUSTED_ORIGINS=https://__DOMAIN__

POSTGRES_DB=pumpwise
POSTGRES_USER=pumpwise_owner
POSTGRES_PASSWORD=__PG__
APP_DB_PASSWORD=__APP__
# The running app uses the limited role, so Row-Level Security applies to it.
DATABASE_URL=postgres://pumpwise_app:__APP__@db:5432/pumpwise
# Only migrations use the owner role.
DATABASE_ADMIN_URL=postgres://pumpwise_owner:__PG__@db:5432/pumpwise
REDIS_URL=redis://redis:6379/0

AWS_REGION=
BACKUP_BUCKET=
# Optional: a Healthchecks.io style ping URL. Backups ping it on success, so you get alerted when they stop.
HEALTHCHECK_URL=

# Shown by /health so you can see which release is live.
APP_VERSION=dev

WEB_WORKERS=2
CELERY_CONCURRENCY=2
